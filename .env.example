# ─── DataProve Environment Variables ────────────────────────────────────────
# Copy this file to .env (backend) and .env (frontend) — never commit .env files.

# ── Backend (.env in /backend) ───────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# MongoDB
# Local: mongodb://localhost:27017/dataprove?replicaSet=rs0
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/dataprove?retryWrites=true&w=majority
# ── Running the backend on the host, against MongoDB in Docker ──────────────
#
# Port 27018, not 27017: docker-compose.dev.yml maps 27018 on the host to 27017
# in the container. Only services inside the compose network use mongodb:27017.
#
# directConnection=true rather than replicaSet=rs0, and the reason is worth
# knowing because the failure is baffling otherwise. mongo-init runs
# rs.initiate({ members: [{ host: 'mongodb:27017' }] }), so the replica set
# advertises itself under its *container* hostname. With replicaSet=rs0 the
# driver connects to localhost:27018, asks the set who its members are, is told
# "mongodb:27017", discards your seed and tries that instead -- which does not
# resolve from Windows. You get a server-selection timeout that looks exactly
# like a wrong port or a stopped container, and chasing either is a dead end.
#
# directConnection skips that discovery and talks to the seed. Transactions
# still work: the node is a replica set member, so sessions are supported, which
# is all the register and update routes need.
#
# Inside compose, use: mongodb://mongodb:27017/dataprove?replicaSet=rs0
MONGO_URI=mongodb://localhost:27018/dataprove?directConnection=true
MONGO_MAX_POOL=100
MONGO_MIN_POOL=10

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password_in_production
# REDIS_TLS=true    # Set to 'true' for ElastiCache in production

# Solana
# Public devnet (rate-limited): https://api.devnet.solana.com
# Private devnet (Helius):      https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Private mainnet (QuickNode):  https://your-endpoint.quiknode.pro/YOUR_TOKEN/
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (.env in /frontend) ─────────────────────────────────────────────

# Which chain the frontend talks to. One of: devnet | testnet | mainnet-beta | localnet
#
# This is the single source of truth for the cluster -- the RPC connection, the
# explorer links and the navbar badge all read it. Leaving it unset does NOT
# break the app: it falls back to devnet and the badge renders "devnet ?" in
# amber to say the fallback was taken. Set it explicitly and the ? disappears.
#
# The ? exists because "we chose devnet" and "nobody configured this" must not
# look identical. An unset value that silently defaults is how a mainnet build
# ends up quietly pointing at the wrong chain.
VITE_SOLANA_CLUSTER=devnet

# Optional. A private RPC endpoint, if you have one. Empty uses the public
# cluster URL, which is rate-limited.
VITE_SOLANA_RPC_URL=

# API base URL (used by socket.js and fetch calls)
VITE_API_BASE_URL=http://localhost:3001

# Pinata IPFS (get a free API key at https://pinata.cloud)
# Leave blank to disable IPFS uploads — app still works without it
VITE_PINATA_JWT=
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud
